/* ==========================================
   ESTILOS GENERALES
   ========================================== */
body {
  font-family: Arial, Helvetica, sans-serif;
  margin: 0;
  padding: 0;
  background-color: #f4f4f9;
  color: #222222; /* Alto contraste para accesibilidad WAVE */
  line-height: 1.6;
}

header {
  background-color: #1a365d;
  color: #ffffff;
  padding: 1rem;
  text-align: center;
}

main {
  padding: 2rem;
  max-width: 1000px;
  margin: 0 auto;
}

footer {
  background-color: #1a365d;
  color: #ffffff;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}

/* ==========================================
   REQUISITO 1 & 3: SALTAR AL CONTENIDO PRINCIPAL (Skip Link)
   Sólo visible cuando está enfocado (tecla Tab)
   ========================================== */
.skip-link {
  position: absolute;
  top: -100px;
  left: 10px;
  background: #ffcc00;
  color: #000000;
  padding: 12px 18px;
  font-weight: bold;
  text-decoration: none;
  z-index: 1000;
  border-radius: 4px;
}

.skip-link:focus {
  top: 10px; /* Aparece arriba en la pantalla al recibir focus */
}

/* ==========================================
   REQUISITO 4 & 7: NAVEGACIÓN Y FLEXBOX
   ========================================== */
.nav-links {
  list-style: none;
  padding: 0;
  margin: 1rem 0 0 0;
  display: flex; /* Flexbox en la navegación */
  justify-content: center;
  gap: 20px;
}

.nav-links a {
  color: #ffffff;
  text-decoration: none;
  font-weight: bold;
  padding: 8px 16px;
  border-radius: 5px;
  background-color: #2b6cb0;
  transition: background-color 0.3s ease;
}

/* Requisito 8: Pseudo-clase :hover */
.nav-links a:hover,
.nav-links a.active {
  background-color: #d69e2e;
  color: #000000;
}

/* ==========================================
   REQUISITO 5 & 8: MODELO DE CAJA EN IMÁGENES Y HOVER
   ========================================== */
img {
  max-width: 100%;
  height: auto;
  display: block;
  
  /* Requisito 5: Modelo de caja (border, padding, border-radius) */
  border: 4px solid #cbd5e0;
  padding: 6px;
  border-radius: 12px;
  background-color: #ffffff;
  
  /* Requisito 8: Transición interactiva con hover */
  transition: transform 0.3s ease, border-color 0.3s ease;
}

img:hover {
  transform: scale(1.03);
  border-color: #d69e2e;
}

/* ==========================================
   REQUISITO 6: CSS GRID (Mínimo 2 columnas)
   ========================================== */
.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Múltiples columnas */
  gap: 20px;
  margin-top: 1.5rem;
}

/* ==========================================
   REQUISITO 7: FLEXBOX EN GALERÍA
   ========================================== */
.flex-gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  margin-top: 1.5rem;
}

.flex-gallery img {
  width: 280px;
}

/* ==========================================
   REQUISITO 9: SELECTOR NTH-CHILD
   Efecto personalizado de bordes redondeados
   ========================================== */
.flex-gallery img:nth-child(odd) {
  border-radius: 25px 0px 25px 0px;
}

.flex-gallery img:nth-child(even) {
  border-radius: 0px 25px 0px 25px;
}

.flex-gallery img:nth-child(3) {
  border-color: #2b6cb0;
}
